# ── MongoDB ────────────────────────────────────────────────────────────────
# Local:
MONGODB_URI=mongodb://localhost:27017
# Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=testgen_suite

# ── Google Gemini ──────────────────────────────────────────────────────────
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── GitHub / Vercel Deployment ─────────────────────────────────────────────
# Repo numeric ID: curl https://api.github.com/repos/<owner>/<repo> | jq .id
GITHUB_REPO_ID=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
VERCEL_PROJECT_NAME=

# ── App ────────────────────────────────────────────────────────────────────
APP_ENV=development
# Comma-separated allowed origins (used for CORS)
# Pydantic-settings will parse this as a JSON list
CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]
